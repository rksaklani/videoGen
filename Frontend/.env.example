# Copy to Frontend/.env — Vite reads these at dev/build time.

# Backend origin without trailing slash. Use empty for local dev so requests go through
# the Vite proxy (see vite.config.js). Example production: https://api.example.com
VITE_API_URL=http://localhost:8000

VITE_APP_NAME=videoGen
VITE_APP_VERSION=1.0.0

# Dev server port (used only by vite.config.js, not bundled into the client)
VITE_DEV_SERVER_PORT=3000
