# Copy to Backend/.env or use repo-root .env (see Backend/env_load.py load order).
# Secrets and overrides — non-secret defaults remain in Backend/config.yaml.

# --- HTTP (uvicorn when using `python -m Backend.main`) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
UVICORN_WORKERS=1

# --- Runtime ---
ENVIRONMENT=development
# ENVIRONMENT=production
# When ENVIRONMENT is production, JWT_SECRET must be set.

# --- Auth ---
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_HOURS=24

# --- Jobs / database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=avatar_studio
JOB_WORKER_MODE=embedded
JOB_QUEUE_MEMORY_ONLY=0
WORKER_POLL_INTERVAL=1.0

# --- Uploads (overrides storage.max_upload_size_mb in config.yaml) ---
MAX_UPLOAD_SIZE_MB=100

# --- Rate limits (slowapi; see Backend/api/rate_limit.py) ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_GENERATE=15/minute
RATE_LIMIT_AUTH=30/minute

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# --- Model / CUDA (optional; often set via config.yaml or scripts) ---
# CUDA_VISIBLE_DEVICES=0
# MODEL_BASE=./Backend/weights
