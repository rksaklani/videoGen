# Copy this to .env and update values
HOST=0.0.0.0
PORT=8000
DEBUG=false
MODEL_BASE=./Backend/weights
CHECKPOINT=hunyuan-video-t2v-720p/transformers/mp_rank_00_model_states_fp8.pt
CUDA_VISIBLE_DEVICES=0
CPU_OFFLOAD=1
DISABLE_SP=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
DEFAULT_STEPS=30
DEFAULT_CFG_SCALE=6.5
DEFAULT_IMAGE_SIZE=512
DEFAULT_SEED=42
MAX_FRAMES=129
MAX_DURATION_SECONDS=30
UPLOAD_DIR=./Backend/data/uploads
OUTPUT_DIR=./Backend/data/outputs
TEMP_DIR=./Backend/data/temp
LOG_LEVEL=INFO
LOG_FILE=./Backend/logs/avatar_api.log
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
